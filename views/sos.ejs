<%- include('partials/header') %>
<section class="panel">
  <h1>🚨 Gửi yêu cầu SOS cứu hộ</h1>
  <p>Điền thông tin bên dưới để tạo yêu cầu cứu hộ. Yêu cầu được <strong>lưu trên trình duyệt của bạn (localStorage)</strong> — phù hợp khi mất mạng, có thể xem lại và gọi trực tiếp đầu số cứu hộ.</p>
  <p class="mock-label"><%= mockLabel %> — form minh hoạ, KHÔNG kết nối trực tiếp tới lực lượng cứu hộ. Nguy cấp hãy gọi <a href="tel:112">112</a> ngay.</p>

  <form id="sos-form" class="sos-form" novalidate>
    <div class="form-row">
      <label for="hoten">Họ và tên *</label>
      <input type="text" id="hoten" name="hoten" required maxlength="100" placeholder="VD: Nguyễn Văn An">
    </div>
    <div class="form-row">
      <label for="sdt">Số điện thoại liên hệ *</label>
      <input type="tel" id="sdt" name="sdt" required pattern="0[0-9]{9}" placeholder="VD: 09xxxxxxxx (10 số)">
    </div>
    <div class="form-row">
      <label for="vitri">Vị trí (thôn/xã/huyện, toạ độ nếu có) *</label>
      <input type="text" id="vitri" name="vitri" required maxlength="200" placeholder="VD: Thôn Luật Chánh, Phước Hiệp, Tuy Phước">
      <button type="button" id="btn-gps" class="btn btn-outline btn-small">📍 Lấy toạ độ GPS</button>
      <span id="gps-status" class="muted"></span>
    </div>
    <div class="form-row">
      <label for="mucdo">Mức độ khẩn cấp *</label>
      <select id="mucdo" name="mucdo" required>
        <option value="">— Chọn mức độ —</option>
        <option value="Nguy cấp tính mạng">🔴 Nguy cấp tính mạng (nước dâng, sập nhà, người bị thương nặng)</option>
        <option value="Khẩn cấp">🟠 Khẩn cấp (mắc kẹt, cô lập, hết lương thực)</option>
        <option value="Cần hỗ trợ">🟡 Cần hỗ trợ (mất điện, cần nhu yếu phẩm, sơ tán)</option>
      </select>
    </div>
    <div class="form-row">
      <label for="mota">Mô tả tình huống *</label>
      <textarea id="mota" name="mota" rows="4" required maxlength="1000" placeholder="VD: Nhà ngập 1,5m, 4 người mắc kẹt trên gác, có 1 người già yếu..."></textarea>
    </div>
    <button type="submit" class="btn btn-danger">🚨 Gửi yêu cầu SOS</button>
    <p id="form-msg" role="status"></p>
  </form>
</section>

<section class="panel">
  <h2>📋 Danh sách yêu cầu SOS đã gửi trên máy này</h2>
  <p class="muted">Lưu trong localStorage của trình duyệt — không gửi lên máy chủ. Cập nhật: 09/11/2026</p>
  <div id="sos-list" class="sos-list"><p class="muted">Chưa có yêu cầu nào.</p></div>
  <button id="btn-clear" class="btn btn-outline btn-small" hidden>🗑️ Xoá tất cả yêu cầu</button>
</section>
<script src="/sos.js"></script>
<%- include('partials/footer') %>